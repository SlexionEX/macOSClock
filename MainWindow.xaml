<Window x:Class="macOSClock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:macOSClock"
        mc:Ignorable="d"
        Title="时钟"
        Height="400" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#00000000"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <!-- ============ 使用 SlexionWindowButtons 字体 ============ -->
        <FontFamily x:Key="WindowButtonsFont">
            pack://application:,,,/SlexionWindowButtons.ttf#SlexionWindowButtons
        </FontFamily>

        <!-- ============ 标题栏按钮样式 ============ -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource WindowButtonsFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 关闭按钮样式 ============ -->
        <Style x:Key="CloseButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 置顶开关样式 ============ -->
        <Style x:Key="TopmostToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    Width="40" Height="22"
                                    CornerRadius="11"
                                    Background="#40FFFFFF"
                                    BorderThickness="1"
                                    BorderBrush="#60FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.15"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Thumb"
                                    Width="16" Height="16"
                                    CornerRadius="8"
                                    Background="White"
                                    HorizontalAlignment="Left"
                                    Margin="3,3,0,3">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#20B2AA"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#20B2AA"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,3,3,3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#60FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 颜色圆点按钮样式 ============ -->
        <Style x:Key="ColorDotStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                BorderThickness="2"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 图标按钮样式 ============ -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ============ 主网格 ============ -->
    <Grid Background="Transparent">

        <!-- 毛玻璃卡片背景 -->
        <Border x:Name="CardBackground"
                Background="#20000000"
                CornerRadius="20">
            <Border BorderBrush="White"
                    BorderThickness="1"
                    CornerRadius="20"
                    Opacity="0.3"/>
        </Border>

        <!-- ============ 主内容 ============ -->
        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="32" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="TitleText"
                           Text="&#xF004; 时钟"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="White"
                           FontFamily="{StaticResource WindowButtonsFont}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="TopmostToggle"
                                  Style="{StaticResource TopmostToggleStyle}"
                                  Checked="TopmostToggle_Checked"
                                  Unchecked="TopmostToggle_Unchecked"
                                  ToolTip="置顶"/>

                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xF001;"
                            Click="MinimizeButton_Click"/>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="&#xF002;"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- 控制栏：语言 + 时区 -->
            <Grid Grid.Row="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="LangLabel"
                               Text="语言"
                               FontSize="11"
                               Foreground="#A0FFFFFF"
                               Margin="2,0,0,4"/>
                    <ComboBox x:Name="LanguageComboBox"
                              FontSize="13"
                              Padding="6,4"
                              Cursor="Hand"
                              local:CornerRadiusHelper.CornerRadius="8"
                              SelectionChanged="LanguageComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="TzLabel"
                               Text="时区"
                               FontSize="11"
                               Foreground="#A0FFFFFF"
                               Margin="2,0,0,4"/>
                    <ComboBox x:Name="TimeZoneComboBox"
                              FontSize="13"
                              Padding="6,4"
                              Cursor="Hand"
                              local:CornerRadiusHelper.CornerRadius="8"
                              SelectionChanged="TimeZoneComboBox_SelectionChanged"/>
                </StackPanel>
            </Grid>

            <!-- 时钟显示 -->
            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0">

                <TextBlock x:Name="TimeText"
                           Text="00:00:00"
                           FontSize="58"
                           FontWeight="Light"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI, Arial"
                           Margin="0,0,0,2"/>

                <TextBlock x:Name="DateText"
                           Text="2024年1月1日 星期一"
                           FontSize="14"
                           Foreground="#E0FFFFFF"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI, 微软雅黑"
                           Opacity="0.8"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="TimeZoneLabel"
                           Text="北京/上海 (UTC+8)"
                           FontSize="11"
                           Foreground="#80FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <Border Height="1"
                        Width="180"
                        Background="#40FFFFFF"
                        Margin="0,0,0,4"/>

                <Border Width="200"
                        Height="3"
                        Background="#20FFFFFF"
                        CornerRadius="2"
                        HorizontalAlignment="Center">
                    <Border x:Name="SecondProgress"
                            Width="0"
                            Background="White"
                            CornerRadius="2"
                            HorizontalAlignment="Left"/>
                </Border>

                <TextBlock x:Name="GreetingText"
                           Text="☀️ 下午好"
                           FontSize="12"
                           Foreground="#C0FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 底部颜色主题选择 -->
            <Border Grid.Row="3"
                    VerticalAlignment="Bottom"
                    Background="#15FFFFFF"
                    CornerRadius="10"
                    Padding="10,6"
                    Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock x:Name="ThemeLabel"
                               Text="主题颜色"
                               FontSize="10"
                               Foreground="#A0FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="ColorAqua"
                                Style="{StaticResource ColorDotStyle}"
                                Content="●"
                                Foreground="#20B2AA"
                                Click="ColorAqua_Click"/>
                        <Button x:Name="ColorCyan"
                                Style="{StaticResource ColorDotStyle}"
                                Content="●"
                                Foreground="#00CCCC"
                                Click="ColorCyan_Click"/>
                        <Button x:Name="ColorPurple"
                                Style="{StaticResource ColorDotStyle}"
                                Content="●"
                                Foreground="#9B59B6"
                                Click="ColorPurple_Click"/>
                        <Button x:Name="ColorPink"
                                Style="{StaticResource ColorDotStyle}"
                                Content="●"
                                Foreground="#FF69B4"
                                Click="ColorPink_Click"/>
                        <Button x:Name="ColorOrange"
                                Style="{StaticResource ColorDotStyle}"
                                Content="●"
                                Foreground="#FF8C00"
                                Click="ColorOrange_Click"/>
                        <Button x:Name="ColorGreen"
                                Style="{StaticResource ColorDotStyle}"
                                Content="●"
                                Foreground="#00C853"
                                Click="ColorGreen_Click"/>
                        <Button x:Name="ColorBlue"
                                Style="{StaticResource ColorDotStyle}"
                                Content="●"
                                Foreground="#1E90FF"
                                Click="ColorBlue_Click"/>
                        <Button x:Name="ColorRed"
                                Style="{StaticResource ColorDotStyle}"
                                Content="●"
                                Foreground="#FF3B30"
                                Margin="0"
                                Click="ColorRed_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
